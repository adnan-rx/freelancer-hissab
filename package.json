{
  "name": "freelancerhisab",
  "private": true,
  "packageManager": "npm@11.6.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "npm --prefix apps/api run start:prod",
    "start:prod": "npm --prefix apps/api run start:prod",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18 <24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
