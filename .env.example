# FreelancerHisab - Environment Variables
# Copy this to .env in each app directory

# ============ apps/api/.env ============
# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/freelancerhisab

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Resend)
RESEND_API_KEY=re_your_api_key

# Exchange Rate API
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# App
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ============ apps/web/.env.local ============
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# NEXT_PUBLIC_APP_URL=http://localhost:3000
